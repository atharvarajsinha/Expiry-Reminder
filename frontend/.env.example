# ---------------------------------------------------------------------------
# Frontend environment
#
# Every VITE_* value is inlined into the JavaScript bundle at build time and is
# therefore PUBLIC. Only non-secret configuration belongs here.
#
# Never put backend secrets in this file:
#   BREVO_API_KEY, JWT_SECRET_KEY, APP_PASSWORD, CRON_TOKEN, MONGODB_URI, ...
# Those stay in the Django backend environment only.
# ---------------------------------------------------------------------------

# Base URL of the Django API, including the /api prefix and no trailing slash.
# Local development:
VITE_API_BASE_URL=http://localhost:8000/api

# Production example (set this in the Vercel dashboard):
# VITE_API_BASE_URL=https://expiry-reminder-api.onrender.com/api

# Header used for the double-submit CSRF token. Must match the backend's
# CSRF_HEADER_NAME setting (default: X-CSRF-Token).
VITE_CSRF_HEADER_NAME=X-CSRF-Token

# Name of the readable CSRF cookie set by the backend. Must match the
# backend's AUTH_COOKIE_CSRF_NAME setting (default: csrf_token).
VITE_CSRF_COOKIE_NAME=csrf_token

# Endpoint used for the startup authentication check (relative to the base URL).
VITE_AUTH_ME_PATH=/auth/me/

# How many days before expiry a date counts as "Expiring Soon".
# Only a fallback: the backend sends the status for every date it returns.
# Should match the backend's EXPIRING_SOON_DAYS (default: 30).
VITE_EXPIRING_SOON_DAYS=30
