# =========================================================================
# Vehicle Document Reminder -- environment configuration
# Copy to .env and fill in real values.  NEVER commit .env.
# =========================================================================

# --- Django ---------------------------------------------------------------
SECRET_KEY=change-me
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Single user authentication (no registration, no user database) -------
APP_USERNAME=admin
APP_PASSWORD=change-me

# --- JWT ------------------------------------------------------------------
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=14
JWT_ISSUER=vehicle-reminder

# --- Cookie token storage -------------------------------------------------
# Tokens are stored in HttpOnly cookies. Set AUTH_COOKIE_SECURE=True in
# production (HTTPS).  Use SameSite=None + Secure=True when the frontend is
# served from a different site than the API.
AUTH_COOKIE_ACCESS_NAME=access_token
AUTH_COOKIE_REFRESH_NAME=refresh_token
AUTH_COOKIE_CSRF_NAME=csrf_token
AUTH_COOKIE_SECURE=True
AUTH_COOKIE_SAMESITE=Lax
# AUTH_COOKIE_DOMAIN=.example.com
AUTH_COOKIE_PATH=/
AUTH_RETURN_TOKENS_IN_BODY=True
CSRF_PROTECTION_ENABLED=True
CSRF_HEADER_NAME=X-CSRF-Token

# --- MongoDB (the only application database) ------------------------------
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/
MONGODB_DATABASE=vehicle_reminder
MONGODB_TIMEOUT_MS=5000

# --- Redis / Celery -------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0
USE_REDIS_CACHE=True

# --- FireAPI (vehicle information provider) -------------------------------
FIREAPI_URL=https://api.fireapi.io/secure-app/rc-vehicle-info/v1
FIREAPI_API_KEY=change-me
# The exact header name may change -- configure it here.
FIREAPI_API_KEY_HEADER=Authorization
# Optional scheme prefix, e.g. "Bearer" when the header is Authorization.
FIREAPI_API_KEY_PREFIX=Bearer
FIREAPI_QUERY_PARAM=vehicle_no
FIREAPI_TIMEOUT=60
FIREAPI_CONNECT_TIMEOUT=10

# --- Brevo transactional email -------------------------------------------
BREVO_API_KEY=change-me
BREVO_SENDER_EMAIL=example@example.com
BREVO_SENDER_NAME=Vehicle Reminder
BREVO_TIMEOUT=30

# --- Reminders ------------------------------------------------------------
REMINDER_EMAIL=example@example.com
# Days before expiry (comma separated). 0 == on the expiry day.
REMINDER_OFFSETS_INSURANCE=7,1,0
REMINDER_OFFSETS_PUCC=7,1,0
# Daily sweep time in TIME_ZONE.
REMINDER_CHECK_HOUR=9
REMINDER_CHECK_MINUTE=0
EXPIRING_SOON_DAYS=30

# --- Frontend / CORS ------------------------------------------------------
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
# CSRF_TRUSTED_ORIGINS=https://app.example.com

# --- Timezone -------------------------------------------------------------
TIME_ZONE=Asia/Kolkata

# --- Logging / throttling -------------------------------------------------
LOG_LEVEL=INFO
THROTTLE_LOGIN=10/min
THROTTLE_VEHICLE_FETCH=20/hour
THROTTLE_VEHICLE_REFRESH=30/hour
THROTTLE_READ=240/min

# --- TLS ------------------------------------------------------------------
# Render/Railway terminate TLS in front of the app; keep this False there.
SECURE_SSL_REDIRECT=False
