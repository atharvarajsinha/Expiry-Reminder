# =========================================================================
# Expiry Reminders -- environment configuration
# Copy to .env and fill in real values.  NEVER commit .env.
# =========================================================================

# --- Django ---------------------------------------------------------------
SECRET_KEY=change-me
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Single user authentication (no registration, no user database) -------
APP_USERNAME=admin
APP_PASSWORD=change-me

# --- JWT ------------------------------------------------------------------
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=14
JWT_ISSUER=expiry-reminder

# --- Cookie token storage -------------------------------------------------
# Tokens are stored in HttpOnly cookies. Set AUTH_COOKIE_SECURE=True in
# production (HTTPS).  Use SameSite=None + Secure=True when the frontend is
# served from a different site than the API.
AUTH_COOKIE_ACCESS_NAME=access_token
AUTH_COOKIE_REFRESH_NAME=refresh_token
AUTH_COOKIE_CSRF_NAME=csrf_token
AUTH_COOKIE_SECURE=True
AUTH_COOKIE_SAMESITE=Lax
# AUTH_COOKIE_DOMAIN=.example.com
AUTH_COOKIE_PATH=/
AUTH_RETURN_TOKENS_IN_BODY=True
CSRF_PROTECTION_ENABLED=True
CSRF_HEADER_NAME=X-CSRF-Token

# --- MongoDB (the only application database) ------------------------------
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/
MONGODB_DATABASE=expiry_reminder
MONGODB_TIMEOUT_MS=5000

# --- Brevo transactional email -------------------------------------------
# Leave blank to run the app with in-app reminders only; nothing else breaks.
BREVO_API_KEY=change-me
BREVO_SENDER_EMAIL=example@example.com
BREVO_SENDER_NAME=Expiry Reminders
BREVO_TIMEOUT=30

# --- Reminders ------------------------------------------------------------
REMINDER_EMAIL=example@example.com

# Days before expiry to send on (comma separated). 0 == on the expiry day.
REMINDER_OFFSETS=30,7,1,0

# Optional per-category overrides. Anything left blank uses REMINDER_OFFSETS.
# REMINDER_OFFSETS_VEHICLE=30,7,1,0
# REMINDER_OFFSETS_CREDIT_CARD=30,7
# REMINDER_OFFSETS_DEBIT_CARD=30,7
# REMINDER_OFFSETS_DOCUMENT=90,30,7,1
# REMINDER_OFFSETS_INSURANCE=30,7,1,0
# REMINDER_OFFSETS_SUBSCRIPTION=14,3
# REMINDER_OFFSETS_WARRANTY=30,7
# REMINDER_OFFSETS_OTHER=30,7,1,0

# How far ahead an expiry is badged "Expiring Soon" in the UI.
EXPIRING_SOON_DAYS=30

# The scheduler: the first API request of each day runs the sweep. Set to
# False if an external cron (below) should be the only trigger.
REMINDER_SWEEP_ON_REQUEST=True

# Shared secret for POST /api/reminders/run/, so an external scheduler can
# send reminders on days nobody opens the app:
#   curl -X POST -H "X-Cron-Token: <value>" https://api.example.com/api/reminders/run/
# Leave blank to restrict that route to signed-in users.
CRON_TOKEN=

# --- Frontend / CORS ------------------------------------------------------
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
# CSRF_TRUSTED_ORIGINS=https://app.example.com

# --- Timezone -------------------------------------------------------------
TIME_ZONE=Asia/Kolkata

# --- Logging / throttling -------------------------------------------------
LOG_LEVEL=INFO
THROTTLE_LOGIN=10/min
THROTTLE_READ=240/min
THROTTLE_WRITE=60/min

# --- TLS ------------------------------------------------------------------
# Render/Railway terminate TLS in front of the app; keep this False there.
SECURE_SSL_REDIRECT=False
