# =========================================================================
# Expiry Reminders -- environment configuration
# Copy to .env and fill in real values.  NEVER commit .env.
#
# Only the variables that need a decision are listed here. Everything else
# (JWT lifetimes, cookie names, timeouts, throttle rates) has a sensible
# default in config/settings.py -- add it to .env only if you need to
# change it.
# =========================================================================

# --- Django ---------------------------------------------------------------
# Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Sign-in (no registration, no user database -- one user, from here) ---
APP_USERNAME=admin
APP_PASSWORD=change-me
JWT_SECRET_KEY=change-me

# Required whenever the frontend is on a different domain to this API.
# Without them the browser drops the login cookie and every request after a
# successful login returns 401. Locally over http, use False and Lax.
AUTH_COOKIE_SECURE=True
AUTH_COOKIE_SAMESITE=None

# --- MongoDB (the only application database) ------------------------------
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/
MONGODB_DATABASE=expiry_reminder

# --- Reminder email (Brevo) -----------------------------------------------
# Leave these blank to run with in-app reminders only: the app still tracks
# everything and shows what is expiring, it just cannot email you.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Expiry Reminders

# Where reminders are delivered. Changeable later in the app's Settings.
REMINDER_EMAIL=example@example.com

# --- The daily check ------------------------------------------------------
# Nothing in this process runs on a timer. Reminder email is sent when an
# external cron job POSTs to /api/reminders/run/ with this token, once a day
# at 09:00 local time:
#
#   curl -X POST -H "X-Cron-Token: <value>" https://your-api/api/reminders/run/
#
# Leave it blank and email only goes out when you press "Send Due Now" in the
# app by hand. See script.txt for the Render cron job setup.
CRON_TOKEN=change-me

# Decides which calendar day "7 days before" lands on. Get this wrong and
# every reminder arrives a day early or late.
TIME_ZONE=Asia/Kolkata

# Days before expiry to send on (comma separated). 0 == on the expiry day.
REMINDER_OFFSETS=30,7,1,0

# Optional per-category overrides. Anything left out uses REMINDER_OFFSETS.
# Categories: vehicle, credit_card, debit_card, document, insurance,
#             subscription, warranty, other
# REMINDER_OFFSETS_CREDIT_CARD=30,7
# REMINDER_OFFSETS_DOCUMENT=90,30,7,1
# REMINDER_OFFSETS_SUBSCRIPTION=14,3

# How far ahead the UI badges something as "Expiring Soon".
EXPIRING_SOON_DAYS=30

# --- Frontend / CORS ------------------------------------------------------
# FRONTEND_URL is the "open the app" link inside every reminder email.
# CORS_ALLOWED_ORIGINS must match the browser's address bar exactly:
# https://, no trailing slash, no path.
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Logging --------------------------------------------------------------
LOG_LEVEL=INFO
